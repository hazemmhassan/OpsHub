# Generate two different random values. Do not commit the real .env file.
N8N_ENCRYPTION_KEY=replace_with_a_long_random_encryption_key
OPSHUB_WEBHOOK_SIGNING_SECRET=replace_with_the_same_32_character_worker_secret

# Required only for the Google Sheets destination.
OPSHUB_GOOGLE_SHEET_ID=
OPSHUB_GOOGLE_SHEET_NAME=Approved Requests
