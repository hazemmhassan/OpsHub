# Public base URL used by the web application.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Public browser-safe values from `supabase status` locally or project settings.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Trusted server-only values. Never expose these with a NEXT_PUBLIC_ prefix.
SUPABASE_SECRET_KEY=sb_secret_replace_me
PUBLIC_SUBMISSION_RATE_LIMIT_KEY=replace_with_at_least_32_random_characters

# Optional private AI intake service. Keep disabled until the service is running.
AI_INTAKE_ENABLED=false
AI_SERVICE_URL=http://127.0.0.1:8001
AI_INTERNAL_KEY=replace_with_the_same_random_32_character_service_key
