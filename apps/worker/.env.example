# Trusted local or hosted Supabase values. Never use a public browser key here.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SECRET_KEY=replace_with_service_role_or_secret_key

# Worker identity and the approved Phase 6 queue defaults.
OPSHUB_WORKER_ID=opshub-local-worker
OPSHUB_WORKER_BATCH_SIZE=10
OPSHUB_WORKER_LEASE_SECONDS=60
OPSHUB_WORKER_POLL_INTERVAL_MS=5000

# Exact receiver origins only, comma-separated. Do not include paths.
OPSHUB_WEBHOOK_ALLOWED_ORIGINS=http://127.0.0.1:5678

# Local HTTP is disabled by default. Production receivers must use HTTPS.
OPSHUB_ALLOW_INSECURE_LOCAL_WEBHOOK=true

# The value stays in the worker environment. PostgreSQL stores only this name.
OPSHUB_WEBHOOK_SIGNING_SECRET=replace_with_at_least_32_random_characters

# Optional local receiver for testing without n8n or Google credentials.
OPSHUB_MOCK_RECEIVER_PORT=5679
